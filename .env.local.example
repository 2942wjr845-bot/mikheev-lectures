# Скопируйте этот файл в .env.local и заполните значения.
# .env.local никогда не коммитится в git.

# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase -> Project Settings -> API Keys -> service_role secret
# ХРАНИТЬ В СЕКРЕТЕ. Не добавлять в NEXT_PUBLIC_*, не показывать в браузере.
SUPABASE_SERVICE_ROLE_KEY=

# Пароль для профессора (доступ к загрузке лекций)
UPLOADER_PASSWORD=
# Пароль для студентов (доступ только на чтение)
READER_PASSWORD=

# Любая длинная случайная строка — используется для подписи cookie-сессии.
# Сгенерировать можно командой: openssl rand -hex 32
SESSION_SECRET=
